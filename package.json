{
  "name": "ai-compute-advisor-v2",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "check": "npm run lint && npm test && npm run build",
    "verify:data": "node scripts/verify-ui-data.mjs",
    "verify:source": "node scripts/extract-live-source.mjs --check",
    "generate:source": "node scripts/extract-live-source.mjs",
    "prebuild": "npm run verify:data && npm run verify:source && npm run verify:planner && npm run generate:standalone",
    "generate:planner": "node scripts/build-combination-planner.mjs",
    "verify:planner": "node scripts/build-combination-planner.mjs --check",
    "generate:standalone": "node scripts/build-standalone.mjs",
    "verify:standalone": "node scripts/build-standalone.mjs --check"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
